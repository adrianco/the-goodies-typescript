{
  "name": "the-goodies-typescript",
  "version": "0.8.1",
  "description": "TypeScript client for The Goodies smart home knowledge graph",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test -- --run",
    "dev": "pnpm -r run dev",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adrianco/the-goodies-typescript.git"
  },
  "keywords": [
    "smart-home",
    "knowledge-graph",
    "mcp",
    "typescript"
  ],
  "author": "Roland",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "packageManager": "pnpm@10.34.5"
}
